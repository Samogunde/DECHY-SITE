# Copy to .env.local for local work. Never commit real values. In production, set these in the host's
# environment settings (Netlify site settings), not in the repository.

# Public origin of the site. Used for canonical URLs, sitemap, Open Graph, and JSON-LD ids.
# The final domain is undecided, so this is the only place it is configured.
SITE_ORIGIN=http://localhost:3000

# Search indexing. Keep "false" for development, previews, and until the domain is chosen and approved.
SITE_INDEXING=false

# Contact form delivery. One of: none | log | webhook | resend
#   none    form validates but reports that delivery is unavailable (safe default)
#   log     writes a redacted line to the server log (local testing only)
#   webhook POSTs JSON to CONTACT_WEBHOOK_URL (works with automation platforms)
#   resend  sends email through the Resend HTTP API
CONTACT_DELIVERY=none
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Business mailbox for inquiries and support requests. Not decided yet: set it here when the
# business email is configured. CONTACT_TO_EMAIL wins; BUSINESS_EMAIL and NOTIFICATION_EMAIL are
# accepted as aliases. Never put a personal address in the repository.
BUSINESS_EMAIL=
NOTIFICATION_EMAIL=

# ---------------- DECHY data layer (inquiries, support requests, conversations) ----------------
# One of: netlify-blobs | file | memory | none. Leave empty to choose automatically: Netlify Blobs on
# Netlify, a local folder (DATA_DIR, default .data/) elsewhere. On Netlify, set netlify-blobs explicitly.
DATA_STORE=
DATA_DIR=
DATA_STORE_NAME=dechy-admin
# AI conversations are deleted after this many days unless they were handed to the team.
CONVERSATION_RETENTION_DAYS=90
# Activity log entries are deleted after this many days (30 to 3650).
ACTIVITY_RETENTION_DAYS=365
# Shared secret (32+ characters) for the daily retention run (netlify/functions/retention.mts calls
# /api/maintenance/ with it). Cleanup also runs lazily, at most every six hours, when the site is used.
MAINTENANCE_SECRET=
# Salt for the hashes used by rate limiting (client addresses are never stored).
RATE_LIMIT_SALT=

# ---------------- Website assistant ----------------
# Without a key the assistant runs in guided mode (no AI). With one it uses the model server-side.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=20000
# Cost limits. When any is reached the assistant answers in automated (non-AI) mode and says so.
# Site-wide AI replies per day (UTC), site-wide output tokens per day, AI replies per visitor per day.
AI_DAILY_CALL_LIMIT=500
AI_DAILY_OUTPUT_TOKEN_LIMIT=300000
AI_VISITOR_DAILY_LIMIT=40

# ---------------- DECHY Admin (private) ----------------
# Admin stays locked until all three are set. Create the hash with: npm run admin:hash
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 random characters.
ADMIN_SESSION_SECRET=
# Optional: a long random token for server-to-server or future mobile app access (Bearer).
ADMIN_API_TOKEN=

# ---------------- Notifications (future mobile admin / push) ----------------
# One of: none | log | webhook. The webhook receives a signed JSON POST per event.
NOTIFICATION_PROVIDER=none
NOTIFICATION_WEBHOOK=
NOTIFICATION_WEBHOOK_SECRET=

# ---------------- Inbound business email (ready for configuration) ----------------
# Shared secret for POST /api/admin/ingest/email (header x-dechy-ingest-secret), at least 32 characters.
EMAIL_INGEST_SECRET=

# Review builds only: show draft sections (owner facts not yet supplied), labeled as drafts.
# Never set in production.
# DECHY_SHOW_DRAFTS=true

# Public contact channels shown on the contact page (owner, 21 October 2026). Each appears only
# when set. PUBLIC_BOOKING_URL must be an https link to the business scheduler; "Book a call"
# buttons across the site use it, and fall back to the contact form when it is empty.
PUBLIC_BOOKING_URL=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
