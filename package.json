{
  "name": "dechy-site",
  "version": "0.1.0",
  "private": true,
  "description": "DECHY: Technology, Software, AI & Digital Solutions. Website application.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "admin:totp": "tsx scripts/admin-totp.ts",
    "admin:vapid": "tsx scripts/admin-vapid.ts",
    "brand:derivatives": "tsx scripts/brand-derivatives.ts"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "@phosphor-icons/react": "2.1.10",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "schema-dts": "^2.1.0",
    "simple-icons": "16.32.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
